<Window x:Class="AskAny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAny"
        Width="660"
        Height="470"
        MinWidth="560"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
    <Border Margin="8"
            Background="White"
            BorderBrush="#DADAE0"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="4"
                              Opacity="0.16"
                              Color="#202124" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PromptRowDefinition" Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MinHeight="48"
                  Margin="12,6,6,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  AllowDrop="True"
                  DragOver="Input_DragOver"
                  Drop="Input_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 显式指定 LineHeight + BlockLineHeight + Ideal 排版，与功能行图标一致，
                     让字形位置可预测；否则 Segoe MDL2 按自身行框排布，实测偏高 3.5px。 -->
                <TextBlock Width="24"
                           Height="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#6E737C"
                           LineHeight="24"
                           LineStackingStrategy="BlockLineHeight"
                           Text="&#xE721;"
                           TextAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal">
                    <!-- BlockLineHeight 会把字形压到行框底部，按截图像素测量回正。
                         取整数 -5 而不是 -4.5：既正好落在单元格中心，又避免半像素偏移带来的模糊。
                         功能行图标用的是同一套偏移思路。 -->
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="-5" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <Grid Grid.Column="1" Margin="6,0,4,0">
                    <Border x:Name="PromptEditorBorder"
                            Background="Transparent"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            AllowDrop="True"
                            DragOver="Input_DragOver"
                            Drop="Input_Drop">
                        <Grid>
                            <TextBox x:Name="PromptBox"
                                     MinHeight="44"
                                     Padding="3,5,3,4"
                                     VerticalContentAlignment="Center"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="17"
                                     Foreground="{StaticResource InkBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxLength="12000"
                                     TextChanged="PromptBox_TextChanged" />
                            <TextBlock x:Name="PromptPlaceholder"
                                       Margin="4,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="17"
                                       Foreground="#A4A5AA"
                                       IsHitTestVisible="False"
                                       TextWrapping="Wrap"
                                       Text="询问 AskAny 获取帮助…" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PromptInfoText"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="AttachmentButton"
                            Style="{StaticResource IconButton}"
                            ToolTip="添加图片（双击 Ctrl 区域截图 · Ctrl+V 粘贴 · 拖入图片）"
                            Click="AttachmentButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE8B9;" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="AttachmentPanel"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="8,3,4,2"
                            Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AttachmentItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="46"
                                            Height="46"
                                            Margin="0,0,6,0"
                                            Background="#F4F5F7"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Image Margin="2"
                                                   Source="{Binding Preview}"
                                                   Stretch="UniformToFill" />
                                            <Button Width="16"
                                                    Height="16"
                                                    Margin="0,-4,-4,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="#CC202124"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    ToolTip="移除图片"
                                                    Click="RemoveAttachmentButton_Click">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="9"
                                                           Foreground="White"
                                                           Text="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="AttachmentTargetText"
                               Margin="1,4,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource LineBrush}" />

            <Grid Grid.Row="2">
                <ListBox x:Name="FunctionList"
                         Margin="10,8,10,6"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FunctionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <!-- 1A：整行单击直接执行，兑现行尾 ▶ 的视觉承诺。 -->
                            <EventSetter Event="MouseLeftButtonUp"
                                         Handler="FunctionItem_MouseLeftButtonUp" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Margin="0,1"
                                                Padding="11,6"
                                                Background="Transparent"
                                                CornerRadius="7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F7F7F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26"
                                        Height="26"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="5">
                                    <Grid Width="21"
                                          Height="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <TextBlock Width="18"
                                                   Height="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   LineHeight="18"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   Text="{Binding Glyph}"
                                                   TextAlignment="Center"
                                                   TextOptions.TextFormattingMode="Ideal">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding IconOffsetX}"
                                                                    Y="{Binding IconOffsetY}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           Text="{Binding Name}" />
                                <TextBlock x:Name="RowRunHint"
                                           Grid.Column="2"
                                           Margin="8,0,4,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#A4A5AA"
                                           Opacity="0"
                                           Text="&#xE724;" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- 箭头只在鼠标悬停时淡入：静态时 6 行都挂一个箭头是纯噪点，
                                     而它现在是真的"点这里就执行"，悬停出现才有意义。 -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                             Value="True">
                                    <Setter TargetName="RowRunHint" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ResponsePanel"
                      Margin="12,8"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="32"
                                Height="32"
                                Style="{StaticResource IconButton}"
                                ToolTip="返回功能列表（←）"
                                Click="BackButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE72B;" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ResponseModeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResponseMetaText"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="复制回答"
                                    Click="CopyButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="保存为 Markdown"
                                    Click="SaveButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="ThinkingExpander"
                              Grid.Row="1"
                              Margin="0,0,0,6"
                              IsExpanded="False"
                              Visibility="Collapsed"
                              Header="思考过程">
                        <Border Margin="0,4,0,0"
                                Padding="10,7"
                                Background="#F8F8FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <RichTextBox x:Name="ThinkingRichText"
                                         MinHeight="52"
                                         MaxHeight="150"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Expander>

                    <Border Grid.Row="2"
                            Background="#FAFAFB"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <RichTextBox x:Name="OutputRichText"
                                         Margin="12"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                            <ProgressBar x:Name="BusyProgress"
                                         Height="3"
                                         Margin="12,0,12,8"
                                         VerticalAlignment="Bottom"
                                         Background="Transparent"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 来源切换条：只有选中检索类功能时才出现，「联网检索」用它覆盖原来的
                 联网解释 / 新闻追踪 / 知乎搜索三个来源。独立占一行，避免功能多时盖住列表。 -->
            <StackPanel x:Name="SourceStrip"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,14,8"
                        Visibility="Collapsed">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,7,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="来源" />
                <Button x:Name="SourceGeneralChip"
                        Style="{StaticResource SourceChip}"
                        Tag="TavilyGeneral"
                        ToolTip="Tavily 全网搜索（Alt+1）"
                        Content="全网"
                        Click="SourceChip_Click" />
                <Button x:Name="SourceNewsChip"
                        Style="{StaticResource SourceChip}"
                        Tag="TavilyNews"
                        ToolTip="Tavily 新闻：偏向主流媒体的实时报道（Alt+2）"
                        Content="新闻"
                        Click="SourceChip_Click" />
                <Button x:Name="SourceZhihuChip"
                        Style="{StaticResource SourceChip}"
                        Tag="Zhihu"
                        ToolTip="知乎站内检索，需要 Access Secret（Alt+3）"
                        Content="知乎"
                        Click="SourceChip_Click" />
                <TextBlock VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="PgUp/PgDn 循环 · Alt+1/2/3 直达" />
            </StackPanel>

            <Grid Grid.Row="4" Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="#EFEFF2"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="&#xE72B;" />
                    </Border>
                    <TextBlock Margin="6,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="按 ESC 关闭" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="模型" />
                <ComboBox x:Name="ModelComboBox"
                          Grid.Column="2"
                          Width="200"
                          Height="30"
                          Margin="0,0,4,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource ComboField}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          SelectionChanged="ModelComboBox_SelectionChanged"
                          LostKeyboardFocus="ModelComboBox_LostKeyboardFocus" />

                <Button Grid.Column="3"
                        Style="{StaticResource IconButton}"
                        AutomationProperties.AutomationId="HistoryButton"
                        ToolTip="历史记录"
                        Click="HistoryButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE81C;" />
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource IconButton}"
                        AutomationProperties.AutomationId="SettingsButton"
                        ToolTip="设置（F1）"
                        Click="SettingsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE713;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
