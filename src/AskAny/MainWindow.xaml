<Window x:Class="AskAny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAny"
        Width="860"
        Height="680"
        MinWidth="760"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Margin="8"
            Background="White"
            BorderBrush="#CCD2DC"
            BorderThickness="1"
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="3"
                              Opacity="0.16"
                              Color="#1F2937" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="118" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34"
                        Height="34"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="4">
                    <Grid>
                        <Image Width="23"
                               Height="23"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Source="Assets/AskAny.ico" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="11,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Text="AskAny" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="双击 Shift 唤起 · 选择功能后按 Enter 执行" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            AutomationProperties.AutomationId="HistoryButton"
                            ToolTip="历史记录"
                            Click="HistoryButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xE81C;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            AutomationProperties.AutomationId="SettingsButton"
                            ToolTip="设置"
                            Click="SettingsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            AutomationProperties.AutomationId="HideButton"
                            ToolTip="隐藏窗口（Esc）"
                            Click="HideButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,8,16,12">
                <Border Background="#FAFBFC"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <TextBox x:Name="PromptBox"
                                 Padding="12,10"
                                 VerticalContentAlignment="Top"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="16"
                                 Foreground="{StaticResource InkBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxLength="12000"
                                 TextChanged="PromptBox_TextChanged" />
                        <TextBlock x:Name="PromptPlaceholder"
                                   Margin="14,12,14,12"
                                   VerticalAlignment="Top"
                                   FontSize="15"
                                   Foreground="#9AA1AD"
                                   IsHitTestVisible="False"
                                   TextWrapping="Wrap"
                                   Text="输入问题，或先选中其他窗口中的文字，再双击 Shift 自动填入…" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource LineBrush}" />

            <Grid Grid.Row="3">
                <ListBox x:Name="FunctionList"
                         Margin="10,8"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FunctionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Margin="0,1"
                                                Padding="12,8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="3,0,0,0"
                                                CornerRadius="3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F5F7FA" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#D5E0F2"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding Glyph}"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="15.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Description}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,4,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#8E96A3"
                                           Text="&#xE724;" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ResponsePanel"
                      Margin="12,10"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="34"
                                Height="34"
                                Style="{StaticResource IconButton}"
                                ToolTip="返回功能列表"
                                Click="BackButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE72B;" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ResponseModeText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="ResponseMetaText"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="复制原始回答"
                                    Click="CopyButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="保存为 Markdown"
                                    Click="SaveButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FCFCFD"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>
                            <RichTextBox x:Name="OutputRichText"
                                         Margin="14"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                            <ProgressBar x:Name="BusyProgress"
                                         Height="3"
                                         Margin="12,0,12,7"
                                         VerticalAlignment="Bottom"
                                         Background="Transparent"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="ESC 隐藏" />
                    <Border Width="1"
                            Height="16"
                            Margin="10,0"
                            Background="{StaticResource LineBrush}" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="↑ ↓ 选择功能" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="提供商" />
                    <ComboBox x:Name="ProviderComboBox"
                              Width="126"
                              Style="{StaticResource ComboField}"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProviderComboBox_SelectionChanged" />
                    <TextBlock Margin="12,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="模型" />
                    <ComboBox x:Name="ModelComboBox"
                              Width="190"
                              Style="{StaticResource ComboField}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              SelectionChanged="ModelComboBox_SelectionChanged"
                              LostKeyboardFocus="ModelComboBox_LostKeyboardFocus" />
                </StackPanel>

                <Button x:Name="PinButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Style="{StaticResource IconButton}"
                        ToolTip="取消窗口置顶"
                        Click="PinButton_Click">
                    <TextBlock x:Name="PinGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE77A;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
