<Window x:Class="AskAny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAny"
        Width="720"
        Height="570"
        MinWidth="620"
        MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
    <Border Margin="10"
            Background="White"
            BorderBrush="#DADAE0"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              ShadowDepth="4"
                              Opacity="0.16"
                              Color="#202124" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PromptRowDefinition" Height="76" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="14,8,8,8"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="38"
                       Height="38"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"
                       Source="Assets/AskAny-transparent.png" />

                <Grid Grid.Column="1" Margin="8,0,4,0">
                    <Border x:Name="PromptEditorBorder"
                            Background="Transparent"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox x:Name="PromptBox"
                                     MinHeight="52"
                                     Padding="3,7,3,5"
                                     VerticalContentAlignment="Center"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                       FontSize="19"
                                     Foreground="{StaticResource InkBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxLength="12000"
                                     TextChanged="PromptBox_TextChanged" />
                            <TextBlock x:Name="PromptPlaceholder"
                                       Margin="4,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="19"
                                       Foreground="#A4A5AA"
                                       IsHitTestVisible="False"
                                       TextWrapping="Wrap"
                                       Text="询问 AskAny 获取帮助…" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PromptInfoText"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="设置（F1）"
                            Click="SettingsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="隐藏窗口（Esc）"
                            Click="HideButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource LineBrush}" />

            <Grid Grid.Row="2">
                <ListBox x:Name="FunctionList"
                         Margin="12,10"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FunctionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Margin="0,2"
                                                Padding="12,9"
                                                Background="Transparent"
                                                CornerRadius="7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F7F7F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="6">
                                    <Grid Width="24"
                                          Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <TextBlock Width="20"
                                                   Height="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   Text="{Binding Glyph}"
                                                   TextAlignment="Center"
                                                   TextOptions.TextFormattingMode="Ideal">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="{Binding IconOffsetX}"
                                                                    Y="{Binding IconOffsetY}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="9,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,4,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#A4A5AA"
                                           Text="&#xE724;" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ResponsePanel"
                      Margin="14,10"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="36"
                                Height="36"
                                Style="{StaticResource IconButton}"
                                ToolTip="返回功能列表（←）"
                                Click="BackButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE72B;" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ResponseModeText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResponseMetaText"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="复制回答"
                                    Click="CopyButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="保存为 Markdown"
                                    Click="SaveButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="ThinkingExpander"
                              Grid.Row="1"
                              Margin="0,0,0,8"
                              IsExpanded="False"
                              Visibility="Collapsed"
                              Header="思考过程">
                        <Border Margin="0,5,0,0"
                                Padding="11,9"
                                Background="#F8F8FA"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <RichTextBox x:Name="ThinkingRichText"
                                         MinHeight="60"
                                         MaxHeight="180"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Expander>

                    <Border Grid.Row="2"
                            Background="#FAFAFB"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <RichTextBox x:Name="OutputRichText"
                                         Margin="14"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                            <ProgressBar x:Name="BusyProgress"
                                         Height="3"
                                         Margin="12,0,12,8"
                                         VerticalAlignment="Bottom"
                                         Background="Transparent"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Background="#EFEFF2"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="&#xE72B;" />
                    </Border>
                    <TextBlock Margin="7,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="按 ESC 关闭" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ComboBox x:Name="ModelComboBox"
                          Grid.Column="1"
                          Width="230"
                          Height="34"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource ComboField}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          SelectionChanged="ModelComboBox_SelectionChanged"
                          LostKeyboardFocus="ModelComboBox_LostKeyboardFocus" />

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        AutomationProperties.AutomationId="HistoryButton"
                        ToolTip="历史记录"
                        Click="HistoryButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE81C;" />
                </Button>

                <Button x:Name="PinButton"
                        Grid.Column="3"
                        Style="{StaticResource IconButton}"
                        ToolTip="取消窗口置顶"
                        Click="PinButton_Click">
                    <TextBlock x:Name="PinGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Text="&#xE77A;" />
                </Button>

                <Button Grid.Column="4"
                        Style="{StaticResource IconButton}"
                        ToolTip="退出 AskAny"
                        Click="ExitButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE7E8;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
