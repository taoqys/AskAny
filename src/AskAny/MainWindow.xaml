<Window x:Class="AskAny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAny"
        Width="720"
        Height="570"
        MinWidth="620"
        MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="10"
            Background="White"
            BorderBrush="#DADAE0"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="4"
                              Opacity="0.18"
                              Color="#202124" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="10">
                    <TextBlock Text="A"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White" />
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Stretch">
                    <TextBox x:Name="PromptBox"
                             Height="50"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             FontSize="19"
                             Foreground="{StaticResource InkBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxLength="8000"
                             TextChanged="PromptBox_TextChanged" />
                    <TextBlock x:Name="PromptPlaceholder"
                               Margin="3,0"
                               VerticalAlignment="Center"
                               FontSize="19"
                               Foreground="#A4A5AA"
                               IsHitTestVisible="False"
                               Text="询问 AskAny 获取帮助…" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="设置"
                            Click="SettingsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="隐藏窗口（Esc）"
                            Click="HideButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource LineBrush}" />

            <Grid Grid.Row="2">
                <ListBox x:Name="FunctionList"
                         Margin="12,10"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FunctionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Margin="0,2"
                                                Padding="14,10"
                                                Background="Transparent"
                                                CornerRadius="10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F6F6F8" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="8">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding Glyph}"
                                               TextAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Description}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,4,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="#A4A5AA"
                                           Text="&#xE724;" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ResponsePanel"
                      Margin="14,12"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="36"
                                Height="36"
                                Style="{StaticResource IconButton}"
                                ToolTip="返回功能列表"
                                Click="BackButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Text="&#xE72B;" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ResponseModeText"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="ResponseMetaText"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="复制回答"
                                    Click="CopyButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE8C8;" />
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                    ToolTip="保存为 Markdown"
                                    Click="SaveButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Text="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FAFAFB"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <TextBox x:Name="OutputBox"
                                     Margin="14"
                                     Padding="0"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="14"
                                     LineHeight="23"
                                     Foreground="{StaticResource InkBrush}"
                                     Background="Transparent"
                                     BorderThickness="0" />
                            <ProgressBar x:Name="BusyProgress"
                                         Height="3"
                                         Margin="12,0,12,8"
                                         VerticalAlignment="Bottom"
                                         Background="Transparent"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Background="#EFEFF2"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="&#xE72B;" />
                    </Border>
                    <TextBlock Margin="7,0,18,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="按 ESC 关闭" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="↑ ↓ 选择功能，Enter 执行" />
                </StackPanel>

                <Button x:Name="ExitButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        ToolTip="退出 AskAny"
                        Click="ExitButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE7E8;" />
                </Button>

                <Button x:Name="PinButton"
                        Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        ToolTip="取消窗口置顶"
                        Click="PinButton_Click">
                    <TextBlock x:Name="PinGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Text="&#xE77A;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
