<Window x:Class="AskAny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AskAny"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="460"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated">
    <Border Margin="8"
            Background="White"
            BorderBrush="#D6DBE3"
            BorderThickness="1"
            CornerRadius="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="3"
                              Opacity="0.15"
                              Color="#1F2937" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PromptRowDefinition" Height="78" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="11,6,7,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="34"
                       Height="34"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"
                       Source="Assets/AskAny.ico" />

                <Grid Grid.Column="1" Margin="8,0,4,0">
                    <Border x:Name="PromptEditorBorder"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid>
                            <TextBox x:Name="PromptBox"
                                     MinHeight="54"
                                     Padding="2,7,2,6"
                                     VerticalContentAlignment="Top"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="16"
                                     Foreground="{StaticResource InkBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxLength="12000"
                                     TextChanged="PromptBox_TextChanged" />
                            <TextBlock x:Name="PromptPlaceholder"
                                       Margin="3,13,3,8"
                                       VerticalAlignment="Top"
                                       FontSize="18"
                                       Foreground="#9AA1AD"
                                       IsHitTestVisible="False"
                                       Text="询问 AskAny 获取帮助…" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PromptInfoText"
                               Margin="3,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </Grid>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SettingsButton"
                        ToolTip="设置（F1）"
                        Click="SettingsButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE713;" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#E9ECF1" />

            <Grid Grid.Row="2">
                <ListBox x:Name="FunctionList"
                         Margin="0,8"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="FunctionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Margin="0,2"
                                                Padding="12,10"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="15">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#FAFAFA" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F1F1F1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="24"
                                      Height="24"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <TextBlock Width="20"
                                               Height="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding Glyph}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                <Setter Property="FontSize" Value="17" />
                                                <Setter Property="LineHeight" Value="20" />
                                                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                                                <Setter Property="Foreground" Value="#30343B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Foreground" Value="#20242A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform X="{Binding IconOffsetX}"
                                                                Y="{Binding IconOffsetY}" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="#20242A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="21"
                                           Foreground="#70757C"
                                           Text="↵">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="ResponsePanel"
                      Margin="8,6"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="32"
                                Height="32"
                                Style="{StaticResource IconButton}"
                                ToolTip="返回功能列表（←）"
                                Click="BackButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE72B;" />
                        </Button>
                        <StackPanel Grid.Column="1"
                                    Margin="7,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ResponseModeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResponseMetaText"
                                       Margin="0,1,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="32"
                                    Height="32"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="复制原始回答"
                                    Click="CopyButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="&#xE8C8;" />
                            </Button>
                            <Button Width="32"
                                    Height="32"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="保存为 Markdown"
                                    Click="SaveButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Text="&#xE74E;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="ThinkingExpander"
                              Grid.Row="1"
                              Margin="0,0,0,6"
                              IsExpanded="False"
                              Visibility="Collapsed"
                              Header="思考过程">
                        <Border Margin="0,5,0,0"
                                Padding="10,8"
                                Background="#F7F8FA"
                                BorderBrush="#E4E8EE"
                                BorderThickness="1"
                                CornerRadius="3">
                            <RichTextBox x:Name="ThinkingRichText"
                                         MinHeight="60"
                                         MaxHeight="170"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Expander>

                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#E4E8EE"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>
                            <RichTextBox x:Name="OutputRichText"
                                         Margin="13"
                                         Padding="0"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled" />
                            <ProgressBar x:Name="BusyProgress"
                                         Height="3"
                                         Margin="12,0,12,7"
                                         VerticalAlignment="Bottom"
                                         Background="Transparent"
                                         Foreground="{StaticResource AccentBrush}"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="3" Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="← 按 ESC 关闭"
                           TextTrimming="CharacterEllipsis" />

                <ComboBox x:Name="ModelComboBox"
                          Grid.Column="1"
                          Width="262"
                          Height="32"
                          Margin="8,0,3,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource ComboField}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          SelectionChanged="ModelComboBox_SelectionChanged"
                          LostKeyboardFocus="ModelComboBox_LostKeyboardFocus" />

                <Button Grid.Column="2"
                        Width="34"
                        Height="34"
                        Style="{StaticResource IconButton}"
                        AutomationProperties.AutomationId="HistoryButton"
                        ToolTip="历史记录"
                        Click="HistoryButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE81C;" />
                </Button>

                <Button x:Name="PinButton"
                        Grid.Column="3"
                        Width="34"
                        Height="34"
                        Style="{StaticResource IconButton}"
                        ToolTip="取消窗口置顶"
                        Click="PinButton_Click">
                    <TextBlock x:Name="PinGlyph"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE77A;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
